{
  "name": "number-adapter",
  "private": false,
  "version": "1.1.0",
  "description": "Lightweight Module for Handling 'SUPER'-Large Numbers",
  "type": "module",
  "main": "number-adapter.umd.cjs",
  "module": "number-adapter.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./number-adapter.js",
      "require": "./number-adapter.umd.cjs",
      "default": "./number-adapter.js"
    }
  },
  "browser": "number-adapter.umd.cjs",
  "unpkg": "number-adapter.umd.cjs",
  "jsdelivr": "number-adapter.umd.cjs",
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "author": "Xizi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VegieDoggie/number-adapter.git"
  },
  "keywords": [
    "bigint",
    "decimal",
    "number",
    "string",
    "convert",
    "parse"
  ],
  "bugs": {
    "url": "https://github.com/VegieDoggie/number-adapter/issues"
  },
  "homepage": "https://github.com/VegieDoggie/number-adapter#readme"
}
